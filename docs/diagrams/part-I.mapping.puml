@startuml part-I-mapping
title XML mapping correspondence - part-I
left to right direction
skinparam nodesep 8

package "instance data" {
  class "partI.procedure.fileReference" as I0
  class "partI.procedure.title" as I1
  class "partI.procedure.procedureType" as I2
  class "partI.contractingAuthority.officialName" as I3
  class "partI.contractingAuthority.identifier.value" as I4
  class "partI.contractingAuthority.country" as I5
  class "partI.publication.reference.identifier" as I6
  class "partI.publication.reference.type" as I7
  class "partI.publication.reference.url" as I8
}

package "UBL XML" {
  class "cbc:ContractFolderID" as U0
  class "cbc:ContractName" as U1
  class "cbc:ProcedureCode" as U2
  class "cac:ContractingParty/cac:Party/cac:PartyName/cbc:Name" as U3
  class "cac:ContractingParty/cac:Party/cac:PartyIdentification/cbc:ID" as U4
  class "cac:ContractingParty/cac:Party/cac:PostalAddress/cac:Country/cbc:IdentificationCode" as U5
  class "cac:AdditionalDocumentReference/cbc:ID" as U6
  class "cac:AdditionalDocumentReference/cbc:DocumentTypeCode" as U7
  class "cac:AdditionalDocumentReference/cac:Attachment/cac:ExternalReference/cbc:URI" as U8
}

I0 --> U0 : value
I1 --> U1 : value
I2 --> U2 : value
I3 --> U3 : value
I4 --> U4 : value
I5 --> U5 : value
I6 --> U6 : value
I7 --> U7 : value
I8 --> U8 : value
@enduml
