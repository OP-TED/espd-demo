@startuml part-I-model
title Canonical instance-data model - part-I
hide empty members

class "partI" as C_partI {
}

class "publication" as C_publication {
}

class "publicationReference" as C_publicationReference {
  *type : enum {TED_CN, NOJCN, ROJCN}
  *identifier : string
  url : string
}

class "contractingAuthority" as C_contractingAuthority {
  *officialName : string
  *country : string
}

class "identifier" as C_identifier {
  *value : string
  *scheme : string
}

class "procedure" as C_procedure {
  *title : string
  *fileReference : string
  *procedureType : string
}

C_publication --> "1" C_publicationReference : reference
C_partI --> "1" C_publication : publication
C_contractingAuthority --> "0..1" C_identifier : identifier
C_partI --> "1" C_contractingAuthority : contractingAuthority
C_partI --> "1" C_procedure : procedure

note bottom : '*' marks a required property. Cardinality is on the association.
@enduml
