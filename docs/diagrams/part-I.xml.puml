@startuml part-I-xml
title UBL XML element structure - part-I
hide empty members

class "QualificationApplicationRequest" as E0 {
  +cbc:ContractFolderID
  +cbc:ContractName
  +cbc:ProcedureCode
}

class "QualificationApplicationRequest/cac:ContractingParty" as E1 {
}

class "QualificationApplicationRequest/cac:ContractingParty/cac:Party" as E2 {
}

class "QualificationApplicationRequest/cac:ContractingParty/cac:Party/cac:PartyName" as E3 {
  +cbc:Name
}

class "QualificationApplicationRequest/cac:ContractingParty/cac:Party/cac:PartyIdentification" as E4 {
  +cbc:ID
}

class "QualificationApplicationRequest/cac:ContractingParty/cac:Party/cac:PostalAddress" as E5 {
}

class "QualificationApplicationRequest/cac:ContractingParty/cac:Party/cac:PostalAddress/cac:Country" as E6 {
  +cbc:IdentificationCode
}

class "QualificationApplicationRequest/cac:AdditionalDocumentReference" as E7 {
  +cbc:ID
  +cbc:DocumentTypeCode
}

class "QualificationApplicationRequest/cac:AdditionalDocumentReference/cac:Attachment" as E8 {
}

class "QualificationApplicationRequest/cac:AdditionalDocumentReference/cac:Attachment/cac:ExternalReference" as E9 {
  +cbc:URI
}

E0 --> "1" E1
E1 --> "1" E2
E2 --> "1" E3
E2 --> "1" E4
E2 --> "1" E5
E5 --> "1" E6
E0 --> "1" E7
E7 --> "1" E8
E8 --> "1" E9
@enduml
