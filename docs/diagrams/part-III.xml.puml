@startuml part-III-xml
title UBL XML element structure - part-III
hide empty members

class "QualificationApplicationResponse" as E0 {
}

class "QualificationApplicationResponse/cac:TenderingCriterion" as E1 {
  +cbc:ID
  +cbc:CriterionTypeCode
  +cbc:Name
}

class "QualificationApplicationResponse/cac:TenderingCriterionResponse" as E2 {
}

class "QualificationApplicationResponse/cac:TenderingCriterionResponse/cac:ValidatedCriterionPropertyID" as E3 {
  +cbc:ID
}

class "QualificationApplicationResponse/cac:TenderingCriterionResponse/cac:ResponseValue" as E4 {
  +cbc:ResponseIndicator
  +cbc:ResponseDate
  +cbc:Description
}

class "QualificationApplicationResponse/cac:TenderingCriterionResponse/cac:EvidenceSupplied" as E5 {
  +cbc:ID
}

class "QualificationApplicationResponse/cac:TenderingCriterionResponse/cac:ApplicablePeriod" as E6 {
  +cbc:StartDate
  +cbc:EndDate
}

class "QualificationApplicationResponse/cac:Evidence" as E7 {
  +cbc:ID
  +cbc:Description
}

class "QualificationApplicationResponse/cac:Evidence/cac:DocumentReference" as E8 {
  +cbc:ID
}

class "QualificationApplicationResponse/cac:Evidence/cac:DocumentReference/cac:Attachment" as E9 {
}

class "QualificationApplicationResponse/cac:Evidence/cac:DocumentReference/cac:Attachment/cac:ExternalReference" as E10 {
  +cbc:URI
}

E0 --> "1" E1
E0 --> "0..*" E2
E2 --> "1" E3
E2 --> "1" E4
E2 --> "1..*" E5
E2 --> "1" E6
E0 --> "0..*" E7
E7 --> "1" E8
E8 --> "1" E9
E9 --> "1" E10

note as N1
  Elements sharing a wrapper name (e.g. cac:TenderingCriterionResponse)
  are collapsed into ONE class showing ALL possible bodies. At runtime
  each instance carries exactly one body (Schematron BR-TCR-03).
end note
@enduml
