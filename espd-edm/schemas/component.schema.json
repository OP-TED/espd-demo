{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component.schema.json",
  "title": "ESPD Component",
  "description": "A recursive component within a section: question groups, questions, subgroups, subcriteria, legislation, captions, or requirements",
  "type": "object",
  "required": [
    "tag",
    "type"
  ],
  "properties": {
    "tag": {
      "type": "string",
      "description": "Short identifier (e.g. QG1, Q1, QSG1, SBC1, L1)"
    },
    "type": {
      "type": "string",
      "enum": [
        "QUESTION_GROUP",
        "QUESTION",
        "QUESTION_SUBGROUP",
        "SUBCRITERION",
        "LEGISLATION",
        "CAPTION",
        "REQUIREMENT"
      ],
      "description": "Component type"
    },
    "cardinality": {
      "type": "string",
      "pattern": "^(0|1)(\\.\\.( 1|n))?$",
      "description": "Cardinality constraint (e.g. 1, 0..1, 1..n, 0..n)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description or question text"
    },
    "title": {
      "type": "string",
      "description": "Title (used primarily for LEGISLATION components)"
    },
    "propertydatatype": {
      "type": "string",
      "enum": [
        "AMOUNT",
        "CODE",
        "CODE_BOOLEAN",
        "CODE_COUNTRY",
        "DATE",
        "DESCRIPTION",
        "ECONOMIC_OPERATOR_IDENTIFIER",
        "EVIDENCE_IDENTIFIER",
        "IDENTIFIER",
        "INDICATOR",
        "LOT_IDENTIFIER",
        "MINIMUM_AMOUNT",
        "MINIMUM_QUANTITY",
        "MINIMUM_QUANTITY_INTEGER",
        "MINIMUM_QUANTITY_YEAR",
        "NONE",
        "PERCENTAGE",
        "PERIOD",
        "QUAL_IDENTIFIER",
        "QUANTITY",
        "QUANTITY_INTEGER",
        "QUANTITY_YEAR",
        "URL"
      ],
      "description": "Data type of the expected answer value"
    },
    "code": {
      "type": "string",
      "description": "Visibility/logic code (ON*, ONTRUE, ONFALSE) or functional code (QUESTION)"
    },
    "requestpath": {
      "type": "string",
      "description": "Path addressing this component in an ESPD Request"
    },
    "responsepath": {
      "type": "string",
      "description": "Path addressing the answer in an ESPD Response"
    },
    "contentpath": {
      "type": "string",
      "description": "Path to the leaf response value"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "component.schema.json"
      },
      "description": "Nested child components (recursive)"
    }
  },
  "additionalProperties": false
}