{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metadata.schema.json",
  "title": "ESPD-EDM Metadata",
  "description": "Version and provenance information for the ESPD data model",
  "type": "object",
  "required": [
    "title",
    "version",
    "description",
    "basedOn",
    "generatedDate"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "title": {
      "type": "string",
      "description": "Full title of the data model"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the model"
    },
    "description": {
      "type": "string",
      "description": "Summary of what the model covers"
    },
    "basedOn": {
      "type": "string",
      "description": "Legal basis (EU regulation reference)"
    },
    "generatedDate": {
      "type": "string",
      "format": "date",
      "description": "Date this version was generated"
    }
  },
  "additionalProperties": false
}