{
  "$comment": "Option B: XML encoding conventions keyed by STRUCTURAL KIND. The whole criterion scaffold is described here once; it is criterion-independent. Leaf VALUE elements are not here — they come from the value-type registry (keyed by ValueDataTypeCode + side). Fixed codelist attributes come from the codelist-attribute profile.",
  "kinds": {
    "criterion": {
      "element": "cac:TenderingCriterion",
      "children": [
        { "element": "cbc:ID", "fromCore": "uuid", "codelist": "criterion-id" },
        { "element": "cbc:CriterionTypeCode", "fromCore": "code", "codelist": "criterion" },
        { "element": "cbc:Name", "fromCore": "name" },
        { "element": "cbc:Description", "fromCore": "description" }
      ]
    },
    "group": {
      "element": "cac:TenderingCriterionPropertyGroup",
      "children": [
        { "element": "cbc:ID", "fromCore": "requestpath", "codelist": "criterion-id" },
        { "element": "cbc:PropertyGroupTypeCode", "fromCore": "condition", "map": { "always": "ON*", "true": "ONTRUE", "false": "ONFALSE" }, "codelist": "property-group-type" }
      ]
    },
    "subgroup": {
      "element": "cac:SubsidiaryTenderingCriterionPropertyGroup",
      "sameAs": "group"
    },
    "leaf": {
      "element": "cac:TenderingCriterionProperty",
      "children": [
        { "element": "cbc:ID", "fromCore": "requestpath", "codelist": "criterion-id" },
        { "element": "cbc:Name", "fromCore": "name" },
        { "element": "cbc:Description", "fromCore": "description" },
        { "element": "cbc:TypeCode", "fromCore": "kind", "codelist": "criterion-element-type" },
        { "element": "cbc:ValueDataTypeCode", "fromCore": "valueType", "codelist": "response-data-type" },
        { "valueBinding": "value-type-registry" }
      ]
    }
  }
}
