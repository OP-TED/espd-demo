{
  "id": "electronic-evidence",
  "$comment": "Reusable ESPD electronic-evidence question branch. $idPrefix and $tag are substituted in strings; instance bindings live in a separate semantic-ID-keyed file.",
  "node": {
    "kind": "question-subgroup",
    "tag": "${tag}",
    "cardinality": "${cardinality}",
    "children": [
      {
        "kind": "question",
        "tag": "Q1",
        "cardinality": "1",
        "id": "${idPrefix}-available-electronically",
        "description": "Is this information available electronically?",
        "valueType": "INDICATOR"
      },
      {
        "kind": "question-subgroup",
        "tag": "QSG1",
        "cardinality": "${evidenceGroupCardinality}",
        "condition": "true",
        "children": [
          {
            "kind": "question",
            "tag": "Q1",
            "cardinality": "1..n",
            "id": "${idPrefix}-id",
            "description": "Evidence Supplied",
            "valueType": "EVIDENCE_IDENTIFIER"
          }
        ]
      }
    ]
  }
}
