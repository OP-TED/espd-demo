{
  "$comment": "Shared conventions used to expand lean criterion nodes into the current EA-compatible component vocabulary.",
  "nodeKinds": {
    "lot-reference": {
      "type": "CRITERION",
      "description": { "source": "tag" },
      "pathMode": "structural"
    },
    "national-subcriterion": {
      "type": "SUBCRITERION",
      "pathMode": "structural",
      "emitEmptyComponents": true
    },
    "legislation": {
      "type": "LEGISLATION",
      "title": { "source": "tag" },
      "description": { "const": "" },
      "pathMode": "structural"
    },
    "requirement-group": {
      "type": "REQUIREMENT_GROUP",
      "defaultCode": "ON*",
      "pathMode": "structural"
    },
    "requirement-subgroup": {
      "type": "REQUIREMENT_SUBGROUP",
      "defaultCode": "ON*",
      "pathMode": "structural"
    },
    "question-group": {
      "type": "QUESTION_GROUP",
      "defaultCode": "ON*",
      "pathMode": "structural"
    },
    "question-subgroup": {
      "type": "QUESTION_SUBGROUP",
      "defaultCode": "ON*",
      "pathMode": "structural"
    },
    "requirement": {
      "type": "REQUIREMENT",
      "code": "REQUIREMENT",
      "pathMode": "value"
    },
    "question": {
      "type": "QUESTION",
      "code": "QUESTION",
      "pathMode": "value"
    }
  },
  "conditions": {
    "always": "ON*",
    "true": "ONTRUE",
    "false": "ONFALSE"
  },
  "paths": {
    "responseValueSuffix": ["R1"],
    "contentValueSuffix": ["RV"]
  }
}
