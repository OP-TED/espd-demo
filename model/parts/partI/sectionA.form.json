{
  "$comment": "Part I Section A — form-structure lens for the publication reference.",
  "part": "I",
  "section": "A",
  "title": "Information about publication",
  "titleKey": "partI.sectionA.title",
  "description": "Reference of the relevant notice published in the Official Journal of the European Union or other identifying information.",
  "descriptionKey": "partI.sectionA.description",
  "filledBy": "contractingAuthority",

  "fields": [
    {
      "dataPath": "partI.publication.type",
      "labelKey": "partI.publication.type",
      "label": "Type of publication reference",
      "uiType": "code",
      "codelist": "docrefcontent-type",
      "required": true,
      "description": "Type of publication reference (e.g. TED contract notice, national journal)."
    },
    {
      "dataPath": "partI.publication.identifier",
      "labelKey": "partI.publication.identifier",
      "label": "Notice number",
      "uiType": "text",
      "required": true,
      "description": "The notice identifier/number.",
      "uiHints": { "lookup": { "name": "ted-notice", "inputKind": "notice-number" } }
    },
    {
      "dataPath": "partI.publication.url",
      "labelKey": "partI.publication.url",
      "label": "Notice URL",
      "uiType": "url",
      "required": false,
      "description": "Optional URL locating the notice.",
      "uiHints": { "lookup": { "name": "ted-notice", "inputKind": "notice-url" } }
    }
  ]
}
